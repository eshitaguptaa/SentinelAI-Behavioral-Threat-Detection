# Application environment
APP_NAME=SentinelAI
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# SQLite by default (absolute path optional; relative paths resolve from process CWD)
# DATABASE_URL=sqlite:///./sentinelai.db

# Comma-separated allowed origins for the Vite frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
