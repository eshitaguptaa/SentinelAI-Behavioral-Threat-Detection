# SentinelAI environment template
# Copy to ".env" in the project root and adjust paths/ports.

# Absolute or repo-relative path to a fitted anomaly detector:
#   - Behavioural Transformer: models/sentinelai_transformer.pt
#     (train with: python train_transformer_model.py)
#   - Isolation Forest (legacy): models/sentinelai_iforest.joblib
#     (prepare with: python integration.py --prepare-model)
SENTINELAI_MODEL_PATH=models/sentinelai_transformer.pt

# Optional force: transformer | iforest (otherwise inferred from file suffix)
# SENTINELAI_DETECTOR=transformer

# FastAPI bind address / port (used by run_backend.py)
API_HOST=127.0.0.1
API_PORT=8000

# Vite dashboard → API base URL (set in frontend/.env or your shell)
VITE_API_BASE_URL=http://127.0.0.1:8000
